{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{mjs,js}",
    "tests/compat/*.ts"
  ],
  "project": [
    "src/**/*.ts!",
    "tests/**/*.{ts,mjs}",
    "!tests/fixtures/**",
    "scripts/**/*.{mjs,js}"
  ],
  "ignoreBinaries": [
    "mkfifo",
    "pgrep"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "cycles": "error"
  },
  "cycles": {
    "allow": [
      [
        "src/workflow/state.ts",
        "src/workflow/product/scopes.ts",
        "src/workflow/product/store.ts"
      ],
      [
        "src/workflow/product/evidence-references.ts",
        "src/workflow/product/exploratory-history.ts"
      ]
    ]
  }
}
