import assert from 'node:assert/strict';
import test from 'node:test';

import physics from '../game-core.js';

test('clamp and distance provide stable geometry primitives', () => {
  assert.equal(physics.clamp(12, 0, 10), 10);
  assert.equal(physics.clamp(-4, 0, 10), 0);
  assert.equal(physics.distance({ x: 0, y: 0 }, { x: 3, y: 4 }), 5);
});

test('circleRectCollision returns a contact normal and penetration depth', () => {
  const hit = physics.circleRectCollision(
    { x: 10, y: 20, radius: 12 },
    { x: 20, y: 12, width: 36, height: 20 },
  );

  assert.equal(hit.hit, true);
  assert.equal(hit.normal.x, -1);
  assert.equal(hit.normal.y, 0);
  assert.ok(hit.penetration > 0);
});

test('resolveCircleRectCollision separates an incoming projectile and reflects it', () => {
  const result = physics.resolveCircleRectCollision(
    { x: 18, y: 30, radius: 10 },
    { x: 120, y: 8 },
    { x: 24, y: 20, width: 40, height: 24 },
  );

  assert.equal(result.hit, true);
  assert.ok(result.position.x < 18);
  assert.ok(result.velocity.x < 0);
});

test('stepProjectile applies gravity and bounces from the ground', () => {
  const result = physics.stepProjectile(
    { x: 140, y: 444, radius: 18, vx: 80, vy: 160 },
    0.1,
    { groundY: 450, left: 0, right: 900, gravity: 500, restitution: 0.5 },
  );

  assert.equal(result.bounced, true);
  assert.equal(result.landed, false);
  assert.equal(result.projectile.y, 432);
  assert.ok(result.projectile.vy < 0);
});

test('impactScore rewards faster hits and tougher materials', () => {
  assert.equal(physics.impactScore(80, 'wood'), 25);
  assert.equal(physics.impactScore(240, 'wood'), 75);
  assert.equal(physics.impactScore(240, 'pig'), 150);
});
